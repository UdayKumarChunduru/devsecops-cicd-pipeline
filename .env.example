# Automatically detected by the pipeline setup scripts using the current working directory (pwd).
PIPELINE_REPO_PATH=/path/to/devsecops-cicd-pipeline

# Reserved for future Jenkins agent authentication support.
JENKINS_AGENT_SECRET=unused

# Jenkins admin username.
# Default value used by the pipeline setup.
JENKINS_ADMIN_USER=admin

# Generated during Jenkins setup and removed during teardown.
JENKINS_ADMIN_PASSWORD=auto-generated

# Generated during SonarQube setup and removed during teardown.
SONAR_ADMIN_PASSWORD=auto-generated
SONAR_TOKEN=auto-generated

# Generated during AWS IAM provisioning and removed during teardown.
AWS_JENKINS_ACCESS_KEY_ID=auto-generated
AWS_JENKINS_SECRET_ACCESS_KEY=auto-generated
AWS_ACCOUNT_ID=123456789012

# Required: paste Snyk API token before running the pipeline setup.
# This value is retained during teardown because it is user-provided.
SNYK_TOKEN=snyk-api-token

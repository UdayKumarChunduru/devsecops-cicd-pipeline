FROM jenkins/jenkins:lts-alpine

USER root

ARG RETRIES="--retry 5 --retry-delay 3"

RUN apk add --no-cache -u \
        bash \
        ca-certificates \
        curl \
        docker-cli \
        docker-cli-buildx \
        docker-cli-compose \
        git \
        gnupg \
        maven \
        nodejs \
        npm \
        openssl \
        python3 \
        py3-pip \
        shadow \
        unzip \
        aws-cli

# 2. Install Kubernetes CLI (kubectl)
RUN curl ${RETRIES} -sLO https://dl.k8s.io/release/$(curl ${RETRIES} -Ls https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/

# 3. Install Helm 3
RUN curl ${RETRIES} -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# 4. Prevent git workspace ownership errors in pipelines
RUN git config --system --add safe.directory '*'

# 5. Install security scanners (Snyk, Trivy, Gitleaks)
RUN npm install -g snyk && \
    curl ${RETRIES} -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin && \
    curl ${RETRIES} -sLo gitleaks.tar.gz https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz && \
    tar -xzf gitleaks.tar.gz gitleaks && \
    mv gitleaks /usr/local/bin/ && \
    rm gitleaks.tar.gz

# 6. Verify tool installations
RUN node --version && \
    npm --version && \
    snyk --version && \
    trivy --version && \
    gitleaks version && \
    python3 --version && \
    pip3 --version && \
    aws --version && \
    docker --version && \
    kubectl version --client && \
    helm version --short

# 7. Install Jenkins plugins
COPY jenkins/plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD curl -f http://localhost:8080/login || exit 1

USER jenkins
